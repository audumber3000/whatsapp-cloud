# WA Reach — production environment for docker-compose.prod.yml
#
#   cp .env.prod.example .env.prod   then fill every value below
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# This is the compose file's env, not the app's. It is the complete list of
# what docker-compose.prod.yml substitutes — a missing value here becomes an
# empty string in the container, which is how the last deploy ended up with a
# JWT secret it never read.
#
# Generate secrets with:  openssl rand -hex 32
# Generate the admin hash with:
#   docker run --rm node:20-slim sh -c "npm i -s bcrypt >/dev/null 2>&1; \
#     node -e \"console.log(require('bcrypt').hashSync(process.argv[1],10))\" 'your-password'"

# ── Public identity ─────────────────────────────────────────────────────────
# The URL patients and staff reach this box on. Used for CORS, for building
# links in emails, and to decide whether to send HSTS headers.
# On the OVH VPS before a domain is pointed at it: http://51.79.146.28:3000
WAREACH_PUBLIC_URL=https://wareach.example.com

# Evolution's own view of where it lives. Internal to the compose network.
SERVER_URL=http://evolution:8080

# Extra browser origins allowed to call the API. The dashboard is same-origin
# and needs none — leave blank unless another product calls WA Reach directly.
CORS_ORIGINS=

# ── Secrets ─────────────────────────────────────────────────────────────────
# 32+ chars. The app refuses to boot in production if this is short or unset.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Evolution's master API key. WA Reach authenticates to Evolution with it.
AUTHENTICATION_API_KEY=

# Shared secret on Evolution's callbacks into WA Reach. Mandatory in
# production — the receiver used to skip its auth check when this was blank.
EVOLUTION_WEBHOOK_SECRET=

# Signs outbound webhooks to other products (MolarPlus, etc.).
WAREACH_WEBHOOK_SECRET=

# ── Databases (both live on this VPS, in the postgres container) ────────────
# Evolution's role and database.
POSTGRES_PASSWORD=

# WA Reach's own role and database, created by ops/postgres-init on a fresh
# volume. Must match what DATABASE_URL is built from in the compose file.
WAREACH_DB_PASSWORD=

# ── Master admin panel ──────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# A bcrypt hash, never the plaintext. Leave blank to disable the panel.
ADMIN_PASSWORD_HASH=

# ── Outbound email (password reset, failure alerts, daily summaries) ────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── Sibling products ────────────────────────────────────────────────────────
# Where WA Reach posts events for MolarPlus. Blank disables the integration.
MOLARPLUS_URL=
