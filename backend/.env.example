# WA Reach — required configuration.
# In production the app refuses to boot if any required value is missing.
# In development, missing secrets are generated per-run (sessions reset on restart).

NODE_ENV=production
PORT=3000

# --- Secrets -----------------------------------------------------------------
# 32+ characters. Generate: openssl rand -hex 32
# Changing this invalidates every issued token, logging all users out.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Admin panel. The password is stored as a bcrypt hash, never plaintext.
# Generate: node -e "console.log(require('bcrypt').hashSync('YOUR_PASSWORD', 12))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Evolution API -----------------------------------------------------------
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=http://wareach:3000/api/evolution/webhook
# Required in production — the webhook receiver rejects everything without it.
EVOLUTION_WEBHOOK_SECRET=

# --- App ---------------------------------------------------------------------
WAREACH_PUBLIC_URL=
# Comma-separated allowlist. Empty means same-origin only.
CORS_ORIGINS=

# --- Email (used for failure alerts and daily summaries) ---------------------
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# --- Database -----------------------------------------------------------------
# WA Reach runs on Postgres. Apply migrations with: node migrate.js
DATABASE_URL=postgres://wareach:PASSWORD@postgres:5432/wareach
PG_POOL_MAX=10
